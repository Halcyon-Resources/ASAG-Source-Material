########################### Loading model architecture ##########################

class ASAGClassifier(nn.Module):

    def __init__(self, model_dir, num_labels):
        super().__init__()

        self.encoder = AutoModel.from_pretrained(model_dir)

        self.classifier = nn.Linear(
            self.encoder.config.hidden_size,
            num_labels
        )

    def forward(self, input_ids, attention_mask):

        outputs = self.encoder(
            input_ids=input_ids,
            attention_mask=attention_mask
        )

        cls_embedding = outputs.last_hidden_state[:, 0]

        logits = self.classifier(cls_embedding)

        return logits
    

def load_model(model_config):

    model_dir = model_config["path"]

    tokenizer = AutoTokenizer.from_pretrained(model_dir)

    with open(
        os.path.join(model_dir, "custom_config.json"),
        "r"
    ) as f:
        custom_config = json.load(f)

    num_labels = custom_config["num_labels"]

    model = ASAGClassifier(
        model_dir,
        num_labels
    )
    
    print(
        f"{model_config['name']} encoder hidden size:",
        model.encoder.config.hidden_size
        )
    
    print(
        f"{model_config['name']} classifier:",
        model.classifier
        )

    classifier_weights = torch.load(
        os.path.join(model_dir, "classifier.pt"),
        map_location=DEVICE
    )

    model.classifier.load_state_dict(classifier_weights)

    model.to(DEVICE)
    model.eval()

    return model, tokenizer


############################ The Prediction part ##################################

def predict(
    model,
    tokenizer,
    question_list,
    student_answer_list,
    reference_answer_list
):

    predictions = []

    for i in tqdm(
        range(0, len(question_list), BATCH_SIZE),
        desc="Inference"
    ):

        batch_question = question_list[i:i + BATCH_SIZE]
        batch_student = student_answer_list[i:i + BATCH_SIZE]
        batch_reference = reference_answer_list[i:i + BATCH_SIZE]

        first_sequence = [
            q + " " + s
            for q, s in zip(
                batch_question,
                batch_student
            )
        ]

        encoding = tokenizer(
            first_sequence,
            batch_reference,
            padding=True,
            truncation=True,
            max_length=MAX_LENGTH,
            return_tensors="pt"
        )

        encoding = {
            "input_ids": encoding["input_ids"].to(DEVICE),
            "attention_mask": encoding["attention_mask"].to(DEVICE)
        }

        with torch.no_grad():

            logits = model(**encoding)

            preds = torch.argmax(
                logits,
                dim=1
            )

        predictions.extend(
            preds.cpu().numpy()
        )

    return np.array(predictions)


########################### Extracting CLS Embeddings #############################

def get_representations(
    model,
    tokenizer,
    question_list,
    student_answer_list,
    reference_answer_list
):

    representations = []

    for i in tqdm(
        range(0, len(question_list), BATCH_SIZE),
        desc="Extracting representations"
    ):

        batch_question = question_list[i:i + BATCH_SIZE]
        batch_student = student_answer_list[i:i + BATCH_SIZE]
        batch_reference = reference_answer_list[i:i + BATCH_SIZE]

        first_sequence = [
            q + " " + s
            for q, s in zip(
                batch_question,
                batch_student
            )
        ]

        encoding = tokenizer(
            first_sequence,
            batch_reference,
            padding=True,
            truncation=True,
            max_length=MAX_LENGTH,
            return_tensors="pt"
        )

        encoding = {
            "input_ids": encoding["input_ids"].to(DEVICE),
            "attention_mask": encoding["attention_mask"].to(DEVICE)
        }

        with torch.no_grad():

            outputs = model.encoder(
                **encoding
            )

            cls_embedding = outputs.last_hidden_state[:, 0]

        representations.append(
            cls_embedding.cpu().numpy()
        )

    return np.vstack(representations)

###################### Macro F1 Drop for Experiment 1 ###########################

def calculate_relative_macro_f1_drop(
    clean_macro_f1,
    perturbed_macro_f1
):

    if clean_macro_f1 == 0:
        raise ValueError(
            "Clean Macro-F1 cannot be zero when calculating relative Macro-F1 drop."
        )

    return (
        (clean_macro_f1 - perturbed_macro_f1)
        / clean_macro_f1
    ) * 100

##################### COMPLETE EXPERIMENT 1 (Macro F1 Drop) ######################

def run_experiment_1(
    model,
    tokenizer,
    df,
    student_column,
    dataset_name
):

    y_true = df["true_label"].values

    y_pred = predict(
        model,
        tokenizer,
        df["question"].tolist(),
        df[student_column].tolist(),
        df["reference_answer"].tolist()
    )

    accuracy = accuracy_score(
        y_true,
        y_pred
    )

    macro_f1 = f1_score(
        y_true,
        y_pred,
        average="macro"
    )

    weighted_f1 = f1_score(
        y_true,
        y_pred,
        average="weighted"
    )

    print(dataset_name)

    print(f"Accuracy    : {accuracy:.4f}")
    print(f"Macro-F1    : {macro_f1:.4f}")
    print(f"Weighted-F1 : {weighted_f1:.4f}")

    print(
        classification_report(
            y_true,
            y_pred,
            target_names=[
                LABEL_NAMES[0],
                LABEL_NAMES[1],
                LABEL_NAMES[2]
            ],
            digits=4
        )
    )

    return {
        "y_true": y_true,
        "y_pred": y_pred,
        "accuracy": accuracy,
        "macro_f1": macro_f1,
        "weighted_f1": weighted_f1
    }

