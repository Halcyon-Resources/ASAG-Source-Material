        continue

    u_stat, p_value = mannwhitneyu(
        retained,
        transitioned,
        alternative="two-sided",
        method="auto"
    )
    
    n_retained = len(retained)
    n_transitioned = len(transitioned)
    
    rank_biserial = (
        1 -
        (2 * u_stat) /
        (n_retained * n_transitioned)
        )

    _, rb_ci_lower, rb_ci_upper = rank_biserial_ci(
        retained,
        transitioned,
        n_boot=5000,
        seed=42
    )
    
