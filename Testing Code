def run_transition_analysis(
    df,
    original_predictions,
    perturbed_predictions,
    dataset_name
):

    df_exp2 = df.copy()

    df_exp2["original_prediction"] = original_predictions
    df_exp2["perturbed_prediction"] = perturbed_predictions

    original_support = (
        df_exp2["true_label"]
        .value_counts()
        .reindex(
            [0, 1, 2],
            fill_value=0
        )
        .values
        .astype(int)
    )

    df_exp2 = df_exp2[
        (df_exp2["semantic_preservation"] == 0)
        &
        (
            df_exp2["original_prediction"]
            ==
            df_exp2["true_label"]
        )
    ].reset_index(drop=True)

    print(f"JTR Analysis: {dataset_name}")

    print(
        "Complete dataset samples:",
        len(df)
    )

    print(
        "Fixed class support:",
        dict(zip([0, 1, 2], original_support))
    )

    print(
        "Samples retained for JTR:",
        len(df_exp2)
    )

    retained_support = (
        df_exp2["original_prediction"]
        .value_counts()
        .reindex(
            [0, 1, 2],
            fill_value=0
        )
        .values
        .astype(int)
    )

    filtered_support = (
        original_support
        -
        retained_support
    )

    if np.any(filtered_support < 0):
        raise ValueError(
            "Filtered support contains negative values. This indicates an inconsistency between the fixed class population and retained samples."
        )

    if not np.array_equal(
        original_support,
        retained_support + filtered_support
    ):
        raise ValueError(
            "Population reconstruction failed: retained + filtered != original support."
        )

    print("\nClass population reconstruction:")

    for class_idx in [0, 1, 2]:

        print(
            f"{LABEL_SHORT[class_idx]}: "
            f"{retained_support[class_idx]} used + "
            f"{filtered_support[class_idx]} filtered = "
            f"{original_support[class_idx]} total"
        )

    transition_counts = pd.crosstab(
        df_exp2["original_prediction"],
        df_exp2["perturbed_prediction"]
    )

    transition_counts = transition_counts.reindex(
        index=[0, 1, 2],
        columns=[0, 1, 2],
        fill_value=0
    )

    transition_rates = transition_counts.div(
        transition_counts.sum(axis=1),
        axis=0
    ) * 100

    transition_rates = transition_rates.fillna(0)

    if len(df_exp2) > 0:

        overall_stability = (
            (
                df_exp2["original_prediction"]
                ==
                df_exp2["perturbed_prediction"]
            ).sum()
            /
            len(df_exp2)
            *
            100
        )

    else:

        overall_stability = 0.0

    print(
        f"\nOverall Judgement Stability: "
        f"{overall_stability:.2f}%"
    )

    print("\nJTR matrix (%):")

    print(
        transition_rates.rename(
            index=LABEL_SHORT,
            columns=LABEL_SHORT
        ).round(2)
    )

    return {
        "df_exp2": df_exp2,

        "transition_rates":
            transition_rates,

        # Fixed dataset population
        "original_support":
            original_support,

        # Samples actually entering JTR
        "retained_support":
            retained_support,

        # Samples excluded from JTR
        "filtered_support":
            filtered_support,

        "overall_stability":
            overall_stability
    }

############## Complete Experiment 3 (Representation Displacement) ###############

def run_experiment_3(
    model,
    tokenizer,
    df_exp2,
    perturbation_name,
    model_name
):
    print(
        f"Exp3: {model_name} | "
        f"{perturbation_name}"
    )


    original_repr = get_representations(
        model,
        tokenizer,
        df_exp2["question"].tolist(),
        df_exp2["student_answer"].tolist(),
        df_exp2["reference_answer"].tolist()
    )

    perturbed_repr = get_representations(
        model,
        tokenizer,
        df_exp2["question"].tolist(),
        df_exp2["corrupted_answer"].tolist(),
        df_exp2["reference_answer"].tolist()
    )
    
    original_norm = np.linalg.norm(
        original_repr,
        axis=1,
        keepdims=True
        )
    
    perturbed_norm = np.linalg.norm(
        perturbed_repr,
        axis=1,
        keepdims=True
        )
    
    original_normalized = (
        original_repr /
        np.clip(original_norm, 1e-12, None)
        )
    
    perturbed_normalized = (
        perturbed_repr /
        np.clip(perturbed_norm, 1e-12, None)
        )
    
    cosine_similarity = np.sum(
        original_normalized *
        perturbed_normalized,
        axis=1
        )
    
    # Numerical safeguard
    cosine_similarity = np.clip(
        cosine_similarity,
        -1.0,
        1.0
        )
    
    representation_shift = (
        1.0 - cosine_similarity
        ) / 2.0

    judgement = np.where(
        df_exp2["original_prediction"].values
        ==
        df_exp2["perturbed_prediction"].values,

        "Retained",

        "Transitioned"
    )

    results = pd.DataFrame({

        "model":
            model_name,

        "perturbation":
            perturbation_name,

        "representation_shift":
            representation_shift,

        "judgement":
            judgement
    })


    print(
        results["judgement"]
        .value_counts()
        .to_string()
    )

    return results
    
