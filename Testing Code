def rank_biserial_ci(
    retained,
    transitioned,
    n_boot=5000,
    seed=42
):

    retained = np.asarray(retained)
    transitioned = np.asarray(transitioned)

    rng = np.random.default_rng(seed)

    n_retained = len(retained)
    n_transitioned = len(transitioned)

    u_obs, _ = mannwhitneyu(
        retained,
        transitioned,
        alternative="two-sided",
        method="auto"
    )

    r_obs = (
        1 -
        (2 * u_obs) /
        (n_retained * n_transitioned)
    )

    bootstrap_effects = np.empty(n_boot)

    for i in range(n_boot):

        retained_sample = rng.choice(
            retained,
            size=n_retained,
            replace=True
        )

        transitioned_sample = rng.choice(
            transitioned,
            size=n_transitioned,
            replace=True
        )

        u_boot, _ = mannwhitneyu(
            retained_sample,
            transitioned_sample,
            alternative="two-sided",
            method="auto"
        )

        bootstrap_effects[i] = (
            1 -
            (2 * u_boot) /
            (n_retained * n_transitioned)
        )

    lower = np.percentile(
        bootstrap_effects,
        2.5
    )

    upper = np.percentile(
        bootstrap_effects,
        97.5
    )

    return r_obs, lower, upper

