    q3_transitioned = transitioned.quantile(0.75)

    mw_results.append({
        "Model": model_name,
        "Perturbation": perturbation,
        "N_Retained": len(retained),
        "N_Transitioned": len(transitioned),
        "Median_Retained": retained.median(),
        "Median_Transitioned": transitioned.median(),
        "U_statistic": u_stat,
        "Rank_Biserial": rank_biserial,
        "Rank_Biserial_CI_Lower": rb_ci_lower,
        "Rank_Biserial_CI_Upper": rb_ci_upper,
        "p_value": p_value,
        "Q1_Retained": q1_retained,
        "Q3_Retained": q3_retained,
        "IQR_Retained": q3_retained - q1_retained, 
